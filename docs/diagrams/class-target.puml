@startuml
title Wildlife Monitor — Target domain and response views
hide methods
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "Domain records" {
  class Sensor {
    +id: UUID
    +deviceId: String
    +name: String
    +createdAt: DateTime
  }

  class Deployment {
    +id: UUID
    +sensorId: UUID
    +name: String
    +parkName: String
    +latitude: Float
    +longitude: Float
    +installedAt: DateTime
    +createdAt: DateTime
  }

  class Detection {
    +id: UUID
    +eventId: UUID <<idempotency key>>
    +deploymentId: UUID
    +capturedAt: DateTime
    +classificationStatus: ClassificationStatus
    +speciesLabel: String?
    +confidence: Float?
    +imageKey: String?
    +modelVersion: String
    +classifiedAt: DateTime
    +createdAt: DateTime
  }

  class User {
    +id: UUID
    +name: String
    +surname: String
    +email: String
    +emailVerified: Boolean
    +role: Role
  }

  enum ClassificationStatus {
    IDENTIFIED
    UNKNOWN
    NO_ANIMAL
  }

  enum Role {
    DEVELOPER
    ADMINISTRATOR
  }
}

Sensor "1" -- "0..*" Deployment
Deployment "1" -- "0..*" Detection
Detection --> ClassificationStatus
User --> Role

class PublicDetectionView <<planned>> {
  +id: UUID
  +capturedAt: DateTime
  +speciesLabel: String
  +latitude: Float
  +longitude: Float
}

class AuthenticatedDetectionView <<planned>> {
  +id: UUID
  +capturedAt: DateTime
  +classificationStatus: ClassificationStatus
  +speciesLabel: String?
  +confidence: Float?
  +modelVersion: String
  +classifiedAt: DateTime
  +parkName: String
  +latitude: Float
  +longitude: Float
}

class TemporaryImageAccess <<planned>> {
  +url: URL
  +expiresAt: DateTime
}

Detection ..> PublicDetectionView : filtered public projection
Detection ..> AuthenticatedDetectionView : private projection
AuthenticatedDetectionView ..> TemporaryImageAccess : image route returns

note bottom of Detection
  Planned rules: immutable record; matching eventId retries
  return the prior row; conflicting eventId reuse is rejected.
end note

note bottom of TemporaryImageAccess
  Planned image route returns a short-lived URL.
  The response views never expose imageKey.
end note
@enduml
