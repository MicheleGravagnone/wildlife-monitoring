@startuml
title Current — API use cases
left to right direction
skinparam packageStyle rectangle

actor "API client\n(no authentication)" as Client
rectangle "Wildlife Monitor REST API" {
  usecase "List sensors" as USensors
  usecase "Get sensor by ID" as USensor
  usecase "Register sensor" as CSensor
  usecase "List deployments" as UDeployments
  usecase "Get deployment by ID" as UDeployment
  usecase "Register deployment" as CDeployment
  usecase "List detections" as UDetections
  usecase "Get detection by ID" as UDetection
  usecase "Create classified detection" as CDetection
  usecase "Validate request with Zod" as Validate
  usecase "Persist/read records\nwith Prisma" as Persist
}

Client --> USensors
Client --> USensor
Client --> CSensor
Client --> UDeployments
Client --> UDeployment
Client --> CDeployment
Client --> UDetections
Client --> UDetection
Client --> CDetection
CSensor ..> Validate : <<include>>
CDeployment ..> Validate : <<include>>
CDetection ..> Validate : <<include>>
USensors ..> Persist : <<include>>
USensor ..> Persist : <<include>>
CSensor ..> Persist : <<include>>
UDeployments ..> Persist : <<include>>
UDeployment ..> Persist : <<include>>
CDeployment ..> Persist : <<include>>
UDetections ..> Persist : <<include>>
UDetection ..> Persist : <<include>>
CDetection ..> Persist : <<include>>

note bottom of Client
  All current resource routes are unauthenticated.
  The API returns full database records.
end note
@enduml
