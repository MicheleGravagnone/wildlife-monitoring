{
  "name": "wildlife-monitor",
  "version": "0.0.1",
  "description": "Wildlife monitoring for ESP32 camera traps: API, AI inference worker, and web frontend.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @wildlife-monitor/api",
    "typecheck": "npm run typecheck -w @wildlife-monitor/api",
    "lint": "npm run lint -w @wildlife-monitor/api",
    "test": "npm run test -w @wildlife-monitor/api",
    "test:e2e": "npm run test:e2e -w @wildlife-monitor/api",
    "start:dev": "npm run start:dev -w @wildlife-monitor/api",
    "db:generate": "npm run db:generate -w @wildlife-monitor/api",
    "db:migrate": "npm run db:migrate -w @wildlife-monitor/api --",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @wildlife-monitor/api",
    "format": "prettier --write \"apps/*/{src,test}/**/*.ts\" \"apps/*/*.{ts,json}\" \"*.json\" \"docs/**/*.md\" README.md",
    "format:check": "prettier --check \"apps/*/{src,test}/**/*.ts\" \"apps/*/*.{ts,json}\" \"*.json\" \"docs/**/*.md\" README.md"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "@scarf/scarf": false
  }
}
