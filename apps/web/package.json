{
  "name": "@wildlife-monitor/web",
  "version": "0.0.1",
  "description": "Trop: the React web frontend for the wildlife monitor.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
